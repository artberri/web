{
  "name": "alberto-varela-web",
  "version": "6.0.0",
  "description": "Alberto Varela's Personal Website",
  "main": "index.js",
  "engines": {
    "node": "^26.0.0",
    "pnpm": "^12.0.0"
  },
  "scripts": {
    "check-links": "linkinator public",
    "build": "hugo --minify --gc",
    "test": "pnpm run check-links",
    "serve": "hugo server",
    "draft": "hugo server --buildDrafts --buildFuture",
    "start": "http-server public -p 1313",
    "deploy": "wrangler pages deploy public --project-name albertovarela"
  },
  "author": {
    "name": "Alberto Varela",
    "email": "hello@albertovarela.net",
    "url": "https://www.albertovarela.net"
  },
  "private": true,
  "devDependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/fjalla-one": "^5.3.0",
    "http-server": "^14.1.1",
    "linkinator": "^8.1.0",
    "prettier": "^3.9.10",
    "reset-css": "^5.0.2",
    "sidr": "^2.2.1",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "@fontsource/karma": "^5.3.0"
  }
}
